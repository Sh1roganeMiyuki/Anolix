{
  "ociVersion": "1.2.1",
  "process": {
    "user": {
      "uid": 0,
      "gid": 0
    },
    "args": [
      "/sysc",
      "162"
    ],
    "env": [
      "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
      "TERM=xterm",
      "HOSTNAME=anolix"
    ],
    "cwd": "/",
    "capabilities": {},
    "rlimits": [
