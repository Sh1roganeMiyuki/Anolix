# 编译产物（根目录下的可执行文件）
/anolix
/sysc
/probe
/.sysc-test

# 构建出的 rootfs（由 scripts/mkrootfs.sh 生成，内容为二进制产物）
/rootfs/

# 本地笔记与讲义，不入库
/logs/

# 个人学习笔记，不入库
/notes/

# Go 常见临时/测试产物
*.test
*.out
coverage.*

# 临时源码缓存（go mod download 拉取依赖源码用于定位实现，勿提交）
/.tmpgm/
/.tmprs/

# kprof.py 测试临时目录（bundle/state/最小策略/负载文件）
/.kprof-tmp/

# 实验/压测临时产物（bundle / state / kb / perf data / 临时 policy；脚本会重建）
/.bench-tmp/

# 一次性 strace 输出（不属于 03 篇的证据链）
/.ls-seq.log

# Python 缓存
__pycache__/
*.pyc

# 编辑器与系统杂项
.vscode/
.idea/
*.swp
.DS_Store

# 构建产物
/bin/

# Go 临时缓存（沙箱只读 /tmp 时用）
/.gotmp/
/.gocache/

# 本地临时/调试产物（perf/pprof、备份、Python 工具缓存）
perf.data
perf.data.*
*.pprof
*.prof
*.tmp
*.bak
*.orig
*.rej
*~
.pytest_cache/
.mypy_cache/
.ruff_cache/
